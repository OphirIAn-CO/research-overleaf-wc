#!/usr/bin/env bash
# research [paper-folder] [first request...]
#   Opens Claude Code inside the folder that holds the paper's .tex, with the research skill active.
#   Registers the folder (local, no Overleaf needed), makes references.bib if there is none,
#   keeps .overleaf-skill/ (local notes) out of git. Installed to ~/.local/bin by ./install.sh.
set -euo pipefail
SELF="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")"
SKILL="$(dirname "$SELF")"
DIR="${1:-.}"; [ $# -gt 0 ] && shift
cd "$DIR" || { echo "no such folder: $DIR"; exit 1; }

TEX="$(find . -maxdepth 3 -name '*.tex' -not -path '*/.*' | head -1)"
[ -n "$TEX" ] || { echo "no .tex file in $(pwd) (looked 3 levels deep). Run research inside the paper's folder."; exit 1; }
ls ./*.bib >/dev/null 2>&1 || { : > references.bib; echo "created references.bib"; }
python3 "$SKILL/scripts/common.py" add "$(pwd)" >/dev/null
mkdir -p .overleaf-skill
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! git check-ignore -q .overleaf-skill/x; then
  echo ".overleaf-skill/" >> .gitignore; echo "added .overleaf-skill/ to .gitignore"
fi

exec claude "/research-overleaf-wc start a writing session in this folder. $*"
